
# --- Shopify (Client ID / Client secret lấy từ Dev Dashboard → app → Settings) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=http://localhost:3000
SCOPES=read_products

# --- Database (docker compose up -d db) ---
# Host/local dev dùng localhost. Docker Compose tự override hostname thành `db`.
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOSTNAME:PORT/DB_NAME?schema=public
POSTGRES_PORT=5432
APP_PORT=3000

# --- App ---
LOG_LEVEL=info              # fatal | error | warn | info | debug | trace
SYNC_PAGE_SIZE=25           # product/trang sync. 25 × (variants 20 + media + price) ≈ 700-800 điểm cost (trần 1.000 điểm/query — tăng lên 50 sẽ bị MAX_COST_EXCEEDED)

# --- Embedding (provider + batch pipeline) ---
EMBEDDING_PROVIDER=fake     # fake | gemini | ollama
EMBEDDING_DIMENSION=768     # phải khớp vector(768) trong Prisma/pgvector
EMBEDDING_VERSION=2         # Fake V2; tăng khi đổi canonical text/thuật toán để buộc re-embed
EMBEDDING_BATCH_SIZE=50     # đọc tối đa 50 Product mỗi batch, không giữ cả catalog trong RAM
EMBEDDING_CONCURRENCY=5     # số request embedding đồng thời trong một batch
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=fake-feature-hash-v2   #fake-feature-hash-v2/gemini-embedding-001 / 
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
EVAL_SHOP_DOMAIN=your-store.myshopify.com  

# --- Seed script (scripts/seed-products.ts) — dùng token của CUSTOM APP riêng có write_products,
#     KHÔNG dùng token của app chính (app chính chỉ có read_products). Xem README mục Shopify Setup.
SEED_SHOP_DOMAIN=your-store.myshopify.com
SEED_ADMIN_ACCESS_TOKEN=
SEED_COUNT=300
SEED_API_VERSION=2026-07
